{
  "name": "taskflow-backend",
  "version": "1.0.0",
  "description": "TaskFlow — Collaborative To-Do App Backend",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "lint": "eslint src/",
    "test": "jest --coverage",
    "migrate": "tsx migrations/run.ts",
